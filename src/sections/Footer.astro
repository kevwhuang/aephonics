---
const year = new Intl.DateTimeFormat('en-US', { timeZone: 'America/Chicago', year: 'numeric' }).format(new Date());
---

<footer class="section border-t border-white-10 bg-zinc-950">
    <div class="shell">
        <p class="text-center text-sm text-zinc-400">
            &copy; <time datetime={year}>{year}</time> Aephonics. All rights reserved.
        </p>
    </div>
</footer>
